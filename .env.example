# Copy this file to .env, then run:
#   ./scripts/gen-secrets.sh >> .env
# to append generated values for APP_ENCRYPTION_KEY, N8N_ENCRYPTION_KEY, and
# SETUP_TOKEN (deliberately not listed below -- appending keeps this file
# free of placeholder duplicates that would confuse which value wins).

### Postgres ###
# Shared by both the backend (its own "leads" database) and n8n (its own
# "n8n" database, created automatically on first boot). Same credentials,
# separate databases, one Postgres instance.
POSTGRES_USER=leads
POSTGRES_PASSWORD=change-me
POSTGRES_DB=leads

### Backend secrets ###
# APP_ENCRYPTION_KEY (Fernet key encrypting OpenAI/SMTP/Slack credentials
# at rest) and SETUP_TOKEN (shared secret gating the /setup wizard) are
# appended below by scripts/gen-secrets.sh -- not declared here.
#
# Public URL the frontend is reachable at. Slack approval buttons link to
# {PUBLIC_APP_URL}/approval, which resumes n8n's wait webhook server-side --
# so if approvers are not on the host machine, this must be a real reachable
# URL (put the frontend, port 3000, behind a reverse proxy / tunnel and set
# this accordingly). n8n itself no longer needs to be publicly reachable.
PUBLIC_APP_URL=http://localhost:3000

### n8n ###
# N8N_ENCRYPTION_KEY (n8n's own at-rest encryption key, separate from
# APP_ENCRYPTION_KEY) is also appended below by scripts/gen-secrets.sh.
#
# Pre-provisioned n8n owner account so no one has to click through n8n's
# signup screen. The password below is hashed at container startup.
N8N_OWNER_EMAIL=owner@example.com
N8N_OWNER_PASSWORD=change-me-too
# Set to "true" to force-reimport n8n/workflows/lead-pipeline.json on next
# boot, discarding any edits made in the n8n UI.
N8N_FORCE_REIMPORT=false

### OpenAI ###
# Model used for enrichment + drafting. The API key itself is entered via
# the /setup wizard, not here -- it's stored encrypted in Postgres.
OPENAI_MODEL=gpt-4o-mini

### Lead pipeline behavior ###
# How many days to look back when deduping incoming leads by email.
DUPLICATE_WINDOW_DAYS=30
